# Copy this file to .env and fill in your keys. .env is ignored by git.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your Anthropic key spans multiple workspaces.
# Find it in the Claude Console under Settings -> Workspaces (starts with wrkspc_).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Anthropic judges: reasoning effort and whether to think. Defaults are fine.
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_THINKING=adaptive

# OpenRouter panels use one key. Use explicit role:openrouter:author/model entries,
# or set the model below for all role:openrouter entries. No extra SDK required.
# OPENROUTER_API_KEY=your-openrouter-key
# AGENTJURY_OPENROUTER_MODEL=openai/gpt-5.2
