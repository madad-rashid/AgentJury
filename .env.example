# Copy this file to .env and fill in your keys. .env is ignored by git.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# One-key OpenRouter panels. Choose explicit vendor/model slugs in --panel.
# OPENROUTER_API_KEY=your-key

# Ollama defaults to http://127.0.0.1:11434/v1 and needs no API key.
# AGENTJURY_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Another OpenAI-compatible chat endpoint, local or remote.
# AGENTJURY_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# AGENTJURY_COMPATIBLE_API_KEY=your-key-if-needed

# Only needed if your Anthropic key spans multiple workspaces.
# Find it in the Claude Console under Settings -> Workspaces (starts with wrkspc_).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Anthropic judges: reasoning effort and whether to think. Defaults are fine.
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_THINKING=adaptive
